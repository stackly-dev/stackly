{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stackly provider versions (stackly.provider-versions/v1)",
  "description": "`versions.json`, schema `stackly.provider-versions/v1`.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Artifact"
      }
    },
    "schema": {
      "type": "string",
      "const": "stackly.provider-versions/v1"
    },
    "software": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z]([a-z0-9]*(-[a-z0-9]+)*)?$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "software",
    "artifacts"
  ],
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "arch": {
          "type": "string"
        },
        "archiveRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked": {
          "anyOf": [
            {
              "$ref": "#/$defs/Blocked"
            },
            {
              "type": "null"
            }
          ]
        },
        "executables": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "licenseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "minOs": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "signingPolicy": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "urls": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]+(\\.[0-9]+)+([+-][0-9A-Za-z.]+)?$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "line",
        "version",
        "os",
        "arch",
        "status"
      ]
    },
    "Blocked": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "owner",
        "since"
      ]
    }
  }
}
