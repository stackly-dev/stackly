{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "The only frame a client sends.",
  "type": "object",
  "properties": {
    "call": {
      "description": "The method and its params.",
      "$ref": "#/$defs/Call"
    },
    "idempotencyKey": {
      "description": "1 to 128 bytes of printable ASCII without spaces. Spec 0007 decides\nwhat it means.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "requestId": {
      "description": "1 to 64 bytes of `[A-Za-z0-9._:-]`, chosen by the client and unique\non the connection while the request runs. `stackly-ipc` uses a\nlowercase UUID v7.",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "call"
  ],
  "$defs": {
    "AbandonOperationParams": {
      "description": "Params of `operation.abandon`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "The revision the person saw when they confirmed; required, so an\nabandon only applies to the state they looked at.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "operationId": {
          "description": "The operation to abandon.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId",
        "expectedRevision"
      ]
    },
    "Call": {
      "description": "One variant per method, tagged by the method name. Methods without\nparams are unit variants, written without `content`.",
      "oneOf": [
        {
          "description": "The first request on every connection.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/HandshakeParams"
            },
            "type": {
              "type": "string",
              "const": "daemon.handshake"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Who the daemon is and where it keeps things.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_info"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The daemon's health and counters.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_health"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Platform capabilities, methods, and event kinds the daemon knows.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_capabilities"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Stops the daemon, or stops it so launchd starts it again.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ShutdownParams"
            },
            "type": {
              "type": "string",
              "const": "daemon.shutdown"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Starts an event subscription.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/SubscribeParams"
            },
            "type": {
              "type": "string",
              "const": "events.subscribe"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Ends an event subscription.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/UnsubscribeParams"
            },
            "type": {
              "type": "string",
              "const": "events.unsubscribe"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One operation with its steps and created items.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/GetOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.get"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One page of operations, newest first.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ListOperationsParams"
            },
            "type": {
              "type": "string",
              "const": "operation.list"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Asks an operation to stop.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/CancelOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.cancel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Queues an operation that needs recovery again.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ResumeOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.resume"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Cleans up what it can of an operation that needs recovery, then\ncloses it.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/AbandonOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.abandon"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "The engine's counters and limits.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "operation.get_stats"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Every catalog entry with the facts about the catalog.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "catalog.list_providers"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "One catalog entry with its versions and artifacts.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/GetProviderParams"
            },
            "type": {
              "type": "string",
              "const": "catalog.get_provider"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "The secret references, from the cached status.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ListSecretsParams"
            },
            "type": {
              "type": "string",
              "const": "secret.list"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One secret reference after a fresh probe.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/SecretStatusParams"
            },
            "type": {
              "type": "string",
              "const": "secret.status"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Fills, generates, copies, or replaces the value behind a reference.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/SetSecretParams"
            },
            "type": {
              "type": "string",
              "const": "secret.set"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Reads the value behind a reference, recorded in the audit.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/RevealSecretParams"
            },
            "type": {
              "type": "string",
              "const": "secret.reveal"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Deletes a reference and the value behind it.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/DeleteSecretParams"
            },
            "type": {
              "type": "string",
              "const": "secret.delete"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Creates an instance and starts the operation that initializes it.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/CreateInstanceParams"
            },
            "type": {
              "type": "string",
              "const": "instance.create"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Starts an instance.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/StartInstanceParams"
            },
            "type": {
              "type": "string",
              "const": "instance.start"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Stops an instance.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/StopInstanceParams"
            },
            "type": {
              "type": "string",
              "const": "instance.stop"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One instance with its status.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/GetInstanceParams"
            },
            "type": {
              "type": "string",
              "const": "instance.get"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One page of instances, retained ones left out.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ListInstancesParams"
            },
            "type": {
              "type": "string",
              "const": "instance.list"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "CancelOperationParams": {
      "description": "Params of `operation.cancel`.",
      "type": "object",
      "properties": {
        "operationId": {
          "description": "The operation to cancel.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "ClientInfo": {
      "description": "Who a client is: for the daemon log, and for handlers that pick how to\ninteract with the person behind it (spec 0011).",
      "type": "object",
      "properties": {
        "interactive": {
          "description": "True when the client can show a dialog the person sees right now:\nalways for the GUI, for the CLI only when stdin and stderr are both\nterminals. Absent means false, so an older client never triggers a\ndialog.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "kind": {
          "description": "The kind of client.",
          "$ref": "#/$defs/ClientKind"
        },
        "pid": {
          "description": "The client's process ID, when it shares it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "version": {
          "description": "The client's own version, 1 to 64 bytes of printable ASCII without\nspaces.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ]
    },
    "ClientKind": {
      "description": "The kinds of client. Open: a newer client may send a value an older\ndaemon reads as `unrecognized`.",
      "oneOf": [
        {
          "description": "The `stackly` CLI.",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "The SwiftUI app.",
          "type": "string",
          "const": "gui"
        },
        {
          "description": "A kind this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "CreateInstanceParams": {
      "description": "Params of `instance.create`.",
      "type": "object",
      "properties": {
        "displayName": {
          "description": "The name to show.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "endpoints": {
          "description": "One request per manifest endpoint that asks for a port.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EndpointRequest"
          }
        },
        "name": {
          "description": "The unique instance name.",
          "type": "string"
        },
        "provider": {
          "description": "The provider to create it from.",
          "$ref": "#/$defs/ProviderSelector"
        },
        "runtimeId": {
          "description": "The installed runtime to run it on.",
          "type": "string",
          "format": "uuid"
        },
        "secrets": {
          "description": "The secret fields and where their values come from.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretFieldInput"
          }
        },
        "settings": {
          "description": "The settings, without secret values.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "provider",
        "runtimeId",
        "settings"
      ]
    },
    "DeleteSecretParams": {
      "description": "Params of `secret.delete`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "The revision of the row the client read, if it names one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "reference": {
          "description": "The reference.",
          "type": "string"
        }
      },
      "required": [
        "reference"
      ]
    },
    "EndpointRequest": {
      "description": "The port request of one manifest endpoint.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The endpoint name from the manifest.",
          "type": "string"
        },
        "port": {
          "description": "The port it asks for.",
          "$ref": "#/$defs/PortRequest"
        }
      },
      "required": [
        "name",
        "port"
      ]
    },
    "EventCursor": {
      "description": "A position in the event stream of one daemon run.",
      "type": "object",
      "properties": {
        "sequence": {
          "description": "The last sequence seen; 0 means no event yet.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "serverInstanceId": {
          "description": "The daemon run the sequence belongs to.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "serverInstanceId",
        "sequence"
      ]
    },
    "GetInstanceParams": {
      "description": "Params of `instance.get`.",
      "type": "object",
      "properties": {
        "instanceId": {
          "description": "The instance to read, retained ones included.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "instanceId"
      ]
    },
    "GetOperationParams": {
      "description": "Params of `operation.get`.",
      "type": "object",
      "properties": {
        "operationId": {
          "description": "The operation to read.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "GetProviderParams": {
      "description": "Params of `catalog.get_provider`.",
      "type": "object",
      "properties": {
        "provider": {
          "description": "The provider ID, such as `official/nats`: 1 to 127 bytes of\n`[a-z0-9/-]` with at most one `/`. A name without its namespace\npasses, so the daemon can suggest the full ID, but never matches a\nprovider.",
          "type": "string"
        }
      },
      "required": [
        "provider"
      ]
    },
    "HandshakeParams": {
      "description": "Params of `daemon.handshake`.\n\n`protocol` is frozen across majors: a daemon of any major reads\n`protocol.major` before anything else, so a client of another major\nalways receives `protocol.major_mismatch`.",
      "type": "object",
      "properties": {
        "client": {
          "description": "Who the client is.",
          "$ref": "#/$defs/ClientInfo"
        },
        "contractDigest": {
          "description": "The client's contract digest, 64 lowercase hex characters.",
          "type": "string"
        },
        "protocol": {
          "description": "The protocol version the client speaks.",
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "protocol",
        "client",
        "contractDigest"
      ]
    },
    "ListInstancesParams": {
      "description": "Params of `instance.list`.",
      "type": "object",
      "properties": {
        "before": {
          "description": "The `next` cursor of the previous page, sent back unchanged.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "limit": {
          "description": "Most instances on the page, 1 to 200; absent means 100.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      }
    },
    "ListOperationsParams": {
      "description": "Params of `operation.list`.",
      "type": "object",
      "properties": {
        "activeOnly": {
          "description": "Only operations that have not ended: `queued`, `running`,\n`cancel_requested`, and `needs_recovery`. Absent means false.",
          "type": "boolean",
          "default": false
        },
        "before": {
          "description": "The `next` cursor of the previous page, sent back unchanged.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "limit": {
          "description": "Most operations on the page, 1 to 200; absent means 50.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "resource": {
          "description": "Only operations on this resource: a runtime, an instance, an\nenvironment, or the manager (`{ kind: manager, id: \"self\" }`).",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "ListSecretsParams": {
      "description": "Params of `secret.list`.",
      "type": "object",
      "properties": {
        "ownerKind": {
          "description": "Only references of this owner kind.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretOwnerKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "description": "Only references with this status.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "PortRequest": {
      "description": "How an IP endpoint asks for its port. Tagged `type` and `content`:\n`{ \"type\": \"fixed\", \"content\": 5432 }` or `{ \"type\": \"auto\" }`.",
      "oneOf": [
        {
          "description": "Exactly this port, never a substitute.",
          "type": "object",
          "properties": {
            "content": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "fixed"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Any free port, picked when the process starts.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ProtocolVersion": {
      "description": "Version of the IPC protocol a peer speaks.\n\n`major` changes when the wire breaks, `minor` when it only gains optional\nadditions. Peers with the same major always talk, whatever their minors.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Bumped for every breaking change to the wire.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "description": "Bumped for every compatible addition.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "ProviderSelector": {
      "description": "The provider an instance is created from.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The provider ID, such as `official/nats`.",
          "type": "string"
        },
        "revision": {
          "description": "The revision to pin. Absent means the revision of the loaded\ncatalog. The first daemon builds refuse an absent revision with\n`request.invalid_params` at `provider.revision`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ]
    },
    "ResourceKind": {
      "description": "The kinds of resource Stackly tracks. Open: a newer daemon may add\nvalues, which older clients read as `unrecognized`.",
      "oneOf": [
        {
          "description": "An installed runtime version.",
          "type": "string",
          "const": "runtime"
        },
        {
          "description": "A configured instance of a runtime.",
          "type": "string",
          "const": "instance"
        },
        {
          "description": "A group of instances.",
          "type": "string",
          "const": "environment"
        },
        {
          "description": "An asynchronous operation.",
          "type": "string",
          "const": "operation"
        },
        {
          "description": "A provider package.",
          "type": "string",
          "const": "provider"
        },
        {
          "description": "A backup of an instance.",
          "type": "string",
          "const": "backup"
        },
        {
          "description": "Stackly itself, the target of an `update_manager` operation; its\n`id` is always [`ResourceRef::MANAGER_ID`] (spec 0007).",
          "type": "string",
          "const": "manager"
        },
        {
          "description": "A secret reference (spec 0011); its `id` is the reference text,\nsuch as `local:erp/postgres/admin`.",
          "type": "string",
          "const": "secret"
        },
        {
          "description": "A kind this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "ResourceRef": {
      "description": "Names one resource, in errors and events.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The canonical text of the resource key: a lowercase UUID for\nruntimes, instances, environments, operations, and backups,\n[`ResourceRef::MANAGER_ID`] for the manager. Spec 0009 fixes the\nform for providers.",
          "type": "string"
        },
        "kind": {
          "description": "What kind of resource this is.",
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ResumeOperationParams": {
      "description": "Params of `operation.resume`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "The revision the client saw; a newer one gets\n`resource.revision_mismatch`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "operationId": {
          "description": "The operation to resume.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "RevealPurpose": {
      "description": "Why a client reveals a value (spec 0011 AC-9).",
      "oneOf": [
        {
          "description": "To show it on screen.",
          "type": "string",
          "const": "show"
        },
        {
          "description": "To copy it.",
          "type": "string",
          "const": "copy"
        },
        {
          "description": "A purpose this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "RevealSecretParams": {
      "description": "Params of `secret.reveal`.",
      "type": "object",
      "properties": {
        "purpose": {
          "description": "Why the client asks; recorded in the audit row.",
          "$ref": "#/$defs/RevealPurpose"
        },
        "reference": {
          "description": "The reference.",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "purpose"
      ]
    },
    "SecretFieldInput": {
      "description": "Where the value of one secret field comes from.",
      "type": "object",
      "properties": {
        "field": {
          "description": "The settings field the secret fills.",
          "type": "string"
        },
        "input": {
          "description": "Where its value comes from.",
          "$ref": "#/$defs/SecretInput"
        }
      },
      "required": [
        "field",
        "input"
      ]
    },
    "SecretInput": {
      "description": "Where a new secret value comes from (spec 0011 AC-5): shared by\n`secret.set` and by the requests that create an instance, bring an\nenvironment up, or restore.\n\nA reference is the text form `local:<segment>/<segment>...`; it is not a\nsecret and may appear anywhere.",
      "oneOf": [
        {
          "description": "A value the person typed, pasted, or piped in.",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "writeOnly": true
            },
            "type": {
              "type": "string",
              "const": "value"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "A new random value the daemon generates.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "generate"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A copy of the value stored under another reference.",
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "copyFrom"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Use an existing reference without writing a value. Only for a new\nresource; `secret.set` refuses it.",
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "bind"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "SecretMode": {
      "description": "How `secret.set` treats a value that exists already: `create` fails on\nan existing item, `replace` on a missing one, and `upsert` takes either\n(spec 0011 AC-5).",
      "oneOf": [
        {
          "description": "The item must not exist yet.",
          "type": "string",
          "const": "create"
        },
        {
          "description": "The item must exist.",
          "type": "string",
          "const": "replace"
        },
        {
          "description": "Either; it is written whichever way.",
          "type": "string",
          "const": "upsert"
        },
        {
          "description": "A mode this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "SecretOwnerKind": {
      "description": "Who owns a secret reference.",
      "oneOf": [
        {
          "description": "An instance.",
          "type": "string",
          "const": "instance"
        },
        {
          "description": "An environment.",
          "type": "string",
          "const": "environment"
        },
        {
          "description": "The user, who registered the reference with `secret.set`.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "A kind this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "SecretStatus": {
      "description": "What the store held when the daemon last looked, never a value.",
      "oneOf": [
        {
          "description": "The store holds a value.",
          "type": "string",
          "const": "present"
        },
        {
          "description": "The store holds none.",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The store could not be checked.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "A status this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "SecretStatusParams": {
      "description": "Params of `secret.status` and the other methods that name only a\nreference.",
      "type": "object",
      "properties": {
        "reference": {
          "description": "The reference.",
          "type": "string"
        }
      },
      "required": [
        "reference"
      ]
    },
    "SetSecretParams": {
      "description": "Params of `secret.set`.",
      "type": "object",
      "properties": {
        "confirmStoredOnly": {
          "description": "Confirms that a replace changes only the stored copy.",
          "type": "boolean",
          "default": false
        },
        "expectedRevision": {
          "description": "The revision of the row the client read, if it names one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "input": {
          "description": "Where the value comes from; `bind` is refused here.",
          "$ref": "#/$defs/SecretInput"
        },
        "mode": {
          "description": "How to treat a value that exists.",
          "$ref": "#/$defs/SecretMode"
        },
        "reference": {
          "description": "The reference to fill.",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "input",
        "mode"
      ]
    },
    "ShutdownMode": {
      "description": "What `daemon.shutdown` asks for. Open: newer daemons may add values.",
      "oneOf": [
        {
          "description": "Stop and stay stopped; the process exits 0.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Stop so launchd starts the daemon again; the process exits 75. Only\na `launchd` daemon accepts it.",
          "type": "string",
          "const": "restart"
        },
        {
          "description": "A mode this build does not know. A client never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "ShutdownParams": {
      "description": "Params of `daemon.shutdown`.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Whether the daemon only stops or stops so launchd starts it again.",
          "$ref": "#/$defs/ShutdownMode"
        }
      },
      "required": [
        "mode"
      ]
    },
    "StartInstanceParams": {
      "description": "Params of `instance.start`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "Refuse with `resource.revision_mismatch` unless the instance is at\nthis revision.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "instanceId": {
          "description": "The instance to start.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "instanceId"
      ]
    },
    "StopInstanceParams": {
      "description": "Params of `instance.stop`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "Refuse with `resource.revision_mismatch` unless the instance is at\nthis revision.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "instanceId": {
          "description": "The instance to stop.",
          "type": "string",
          "format": "uuid"
        },
        "overrideLeases": {
          "description": "Stop even when an active environment lease holds the instance.",
          "type": "boolean"
        }
      },
      "required": [
        "instanceId",
        "overrideLeases"
      ]
    },
    "SubscribeParams": {
      "description": "Params of `events.subscribe`.",
      "type": "object",
      "properties": {
        "kinds": {
          "description": "Full kinds such as `instance.state_changed` or area prefixes ending\nin a dot such as `operation.`; empty means every kind. At most 32.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "description": "Only events about this resource.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "since": {
          "description": "Replay every event after this cursor, or null for new events only.",
          "anyOf": [
            {
              "$ref": "#/$defs/EventCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "UnsubscribeParams": {
      "description": "Params of `events.unsubscribe`.",
      "type": "object",
      "properties": {
        "subscriptionId": {
          "description": "The subscription to end.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "subscriptionId"
      ]
    }
  }
