{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "The only frame a client sends.",
  "type": "object",
  "properties": {
    "call": {
      "description": "The method and its params.",
      "$ref": "#/$defs/Call"
    },
    "idempotencyKey": {
      "description": "1 to 128 bytes of printable ASCII without spaces. Spec 0007 decides\nwhat it means.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "requestId": {
      "description": "1 to 64 bytes of `[A-Za-z0-9._:-]`, chosen by the client and unique\non the connection while the request runs. `stackly-ipc` uses a\nlowercase UUID v7.",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "call"
  ],
  "$defs": {
    "AbandonOperationParams": {
      "description": "Params of `operation.abandon`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "The revision the person saw when they confirmed; required, so an\nabandon only applies to the state they looked at.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "operationId": {
          "description": "The operation to abandon.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId",
        "expectedRevision"
      ]
    },
    "Call": {
      "description": "One variant per method, tagged by the method name. Methods without\nparams are unit variants, written without `content`.",
      "oneOf": [
        {
          "description": "The first request on every connection.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/HandshakeParams"
            },
            "type": {
              "type": "string",
              "const": "daemon.handshake"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Who the daemon is and where it keeps things.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_info"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The daemon's health and counters.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_health"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Platform capabilities, methods, and event kinds the daemon knows.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon.get_capabilities"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Starts an event subscription.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/SubscribeParams"
            },
            "type": {
              "type": "string",
              "const": "events.subscribe"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Ends an event subscription.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/UnsubscribeParams"
            },
            "type": {
              "type": "string",
              "const": "events.unsubscribe"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One operation with its steps and created items.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/GetOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.get"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "One page of operations, newest first.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ListOperationsParams"
            },
            "type": {
              "type": "string",
              "const": "operation.list"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Asks an operation to stop.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/CancelOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.cancel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Queues an operation that needs recovery again.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/ResumeOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.resume"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Cleans up what it can of an operation that needs recovery, then\ncloses it.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/AbandonOperationParams"
            },
            "type": {
              "type": "string",
              "const": "operation.abandon"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "The engine's counters and limits.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "operation.get_stats"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "CancelOperationParams": {
      "description": "Params of `operation.cancel`.",
      "type": "object",
      "properties": {
        "operationId": {
          "description": "The operation to cancel.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "ClientInfo": {
      "description": "Who a client is: for the daemon log, and for handlers that pick how to\ninteract with the person behind it (spec 0011).",
      "type": "object",
      "properties": {
        "interactive": {
          "description": "True when the client can show a dialog the person sees right now:\nalways for the GUI, for the CLI only when stdin and stderr are both\nterminals. Absent means false, so an older client never triggers a\ndialog.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "kind": {
          "description": "The kind of client.",
          "$ref": "#/$defs/ClientKind"
        },
        "pid": {
          "description": "The client's process ID, when it shares it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "version": {
          "description": "The client's own version, 1 to 64 bytes of printable ASCII without\nspaces.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ]
    },
    "ClientKind": {
      "description": "The kinds of client. Open: a newer client may send a value an older\ndaemon reads as `unrecognized`.",
      "oneOf": [
        {
          "description": "The `stackly` CLI.",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "The SwiftUI app.",
          "type": "string",
          "const": "gui"
        },
        {
          "description": "A kind this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "EventCursor": {
      "description": "A position in the event stream of one daemon run.",
      "type": "object",
      "properties": {
        "sequence": {
          "description": "The last sequence seen; 0 means no event yet.",
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "serverInstanceId": {
          "description": "The daemon run the sequence belongs to.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "serverInstanceId",
        "sequence"
      ]
    },
    "GetOperationParams": {
      "description": "Params of `operation.get`.",
      "type": "object",
      "properties": {
        "operationId": {
          "description": "The operation to read.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "HandshakeParams": {
      "description": "Params of `daemon.handshake`.\n\n`protocol` is frozen across majors: a daemon of any major reads\n`protocol.major` before anything else, so a client of another major\nalways receives `protocol.major_mismatch`.",
      "type": "object",
      "properties": {
        "client": {
          "description": "Who the client is.",
          "$ref": "#/$defs/ClientInfo"
        },
        "contractDigest": {
          "description": "The client's contract digest, 64 lowercase hex characters.",
          "type": "string"
        },
        "protocol": {
          "description": "The protocol version the client speaks.",
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "protocol",
        "client",
        "contractDigest"
      ]
    },
    "ListOperationsParams": {
      "description": "Params of `operation.list`.",
      "type": "object",
      "properties": {
        "activeOnly": {
          "description": "Only operations that have not ended: `queued`, `running`,\n`cancel_requested`, and `needs_recovery`. Absent means false.",
          "type": "boolean",
          "default": false
        },
        "before": {
          "description": "The `next` cursor of the previous page, sent back unchanged.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "limit": {
          "description": "Most operations on the page, 1 to 200; absent means 50.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "resource": {
          "description": "Only operations on this resource: a runtime, an instance, an\nenvironment, or the manager (`{ kind: manager, id: \"self\" }`).",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "ProtocolVersion": {
      "description": "Version of the IPC protocol a peer speaks.\n\n`major` changes when the wire breaks, `minor` when it only gains optional\nadditions. Peers with the same major always talk, whatever their minors.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Bumped for every breaking change to the wire.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "description": "Bumped for every compatible addition.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "ResourceKind": {
      "description": "The kinds of resource Stackly tracks. Open: a newer daemon may add\nvalues, which older clients read as `unrecognized`.",
      "oneOf": [
        {
          "description": "An installed runtime version.",
          "type": "string",
          "const": "runtime"
        },
        {
          "description": "A configured instance of a runtime.",
          "type": "string",
          "const": "instance"
        },
        {
          "description": "A group of instances.",
          "type": "string",
          "const": "environment"
        },
        {
          "description": "An asynchronous operation.",
          "type": "string",
          "const": "operation"
        },
        {
          "description": "A provider package.",
          "type": "string",
          "const": "provider"
        },
        {
          "description": "A backup of an instance.",
          "type": "string",
          "const": "backup"
        },
        {
          "description": "Stackly itself, the target of an `update_manager` operation; its\n`id` is always [`ResourceRef::MANAGER_ID`] (spec 0007).",
          "type": "string",
          "const": "manager"
        },
        {
          "description": "A kind this build does not know. The daemon never sends it.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "ResourceRef": {
      "description": "Names one resource, in errors and events.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The canonical text of the resource key: a lowercase UUID for\nruntimes, instances, environments, operations, and backups,\n[`ResourceRef::MANAGER_ID`] for the manager. Spec 0009 fixes the\nform for providers.",
          "type": "string"
        },
        "kind": {
          "description": "What kind of resource this is.",
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ResumeOperationParams": {
      "description": "Params of `operation.resume`.",
      "type": "object",
      "properties": {
        "expectedRevision": {
          "description": "The revision the client saw; a newer one gets\n`resource.revision_mismatch`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "operationId": {
          "description": "The operation to resume.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "operationId"
      ]
    },
    "SubscribeParams": {
      "description": "Params of `events.subscribe`.",
      "type": "object",
      "properties": {
        "kinds": {
          "description": "Full kinds such as `instance.state_changed` or area prefixes ending\nin a dot such as `operation.`; empty means every kind. At most 32.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "description": "Only events about this resource.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "since": {
          "description": "Replay every event after this cursor, or null for new events only.",
          "anyOf": [
            {
              "$ref": "#/$defs/EventCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "UnsubscribeParams": {
      "description": "Params of `events.unsubscribe`.",
      "type": "object",
      "properties": {
        "subscriptionId": {
          "description": "The subscription to end.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "subscriptionId"
      ]
    }
  }
}
