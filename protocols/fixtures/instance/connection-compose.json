    {
      "name": "two secrets in one entry",
      "parts": [
        {
          "kind": "text",
          "text": "fake://"
        },
        {
          "kind": "secret",
          "secret": {
            "field": "appUser",
            "reference": "local:instance/0192f000-0000-7000-8000-00000000000a/app-user"
          }
        },
        {
          "kind": "text",
          "text": ":"
        },
        {
          "kind": "secret",
          "secret": {
            "field": "superuserPassword",
            "reference": "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password"
          }
        },
        {
          "kind": "text",
          "text": "@h/"
        }
      ],
      "values": {
        "local:instance/0192f000-0000-7000-8000-00000000000a/app-user": "us er",
        "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password": "p@ss"
      },
      "expected": "fake://us%20er:p%40ss@h/"
    },
    {
      "name": "text parts are written as they are",
      "parts": [
        {
          "kind": "text",
          "text": "http://h/a%20b?x=1&y=%C3%A9"
        }
      ],
      "values": {},
      "expected": "http://h/a%20b?x=1&y=%C3%A9"
    },
    {
      "name": "a value nobody asked for is ignored",
      "parts": [
        {
          "kind": "text",
          "text": "nats://h"
        }
      ],
      "values": {
        "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password": "unused"
      },
      "expected": "nats://h"
    },
    {
      "name": "a missing value is an error, never an empty string",
