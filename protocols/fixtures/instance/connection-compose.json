          "secret": {
            "field": "superuserPassword",
            "reference": "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password"
          }
        },
        {
          "kind": "text",
          "text": "@127.0.0.1:5432/postgres"
        }
      ],
      "values": {
        "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password": "hunter2"
      },
      "expected": "postgresql://postgres:hunter2@127.0.0.1:5432/postgres"
