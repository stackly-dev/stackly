    {
      "name": "an empty value is a value",
      "parts": [
        {
          "kind": "text",
          "text": "postgresql://postgres:"
        },
        {
          "kind": "secret",
          "secret": {
            "field": "superuserPassword",
            "reference": "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password"
