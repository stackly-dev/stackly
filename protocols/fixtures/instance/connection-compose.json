          "kind": "text",
          "text": "postgresql://postgres:"
        },
        {
          "kind": "secret",
          "secret": {
            "field": "superuserPassword",
            "reference": "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password"
          }
        },
        {
          "kind": "text",
          "text": "@127.0.0.1:5432/postgres"
        }
      ],
      "values": {},
      "missingValue": "local:instance/0192f000-0000-7000-8000-00000000000a/superuser-password"
    },
    {
      "name": "the second of two secrets is missing",
