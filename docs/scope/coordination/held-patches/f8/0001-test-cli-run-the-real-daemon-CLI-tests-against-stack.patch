+    let scripts = Scripts::new();
+    let hold = HoldHandle::new();
+    scripts.add(
+        "undoable",
+        Script::new(
+            OperationKind::CreateInstance,
+            ScriptedWork::new()
+                .step("reserve")
+                .creates_instance_tree()
+                .step("wait")
+                .hold(&hold),
+        )
